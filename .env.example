# Copie para .env e preencha. Nunca commite o .env.

# Banco (docker compose)
POSTGRES_USER=biblia
POSTGRES_PASSWORD=
POSTGRES_DB=biblia
DATABASE_URL=postgresql+asyncpg://biblia:SENHA@127.0.0.1:5433/biblia
DATABASE_URL_TEST=postgresql+asyncpg://biblia:SENHA@127.0.0.1:5433/biblia_test

# Agente (Claude Agent SDK). Sem ANTHROPIC_API_KEY, o SDK usa o Claude Code logado nesta máquina.
# Método oficial da Anthropic para apps: chave de API (pago por uso) + PERMITIR_API_PAGA=true.
ANTHROPIC_API_KEY=
PERMITIR_API_PAGA=false
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
# Esforço nos estudos de capítulo inteiro (medido pela avaliação)
CLAUDE_EFFORT_ESTUDO=high
# Tempo máximo de uma resposta do agente, em segundos
AGENT_TIMEOUT_S=300
# Vídeo TikTok e Complexo pesquisam mais: limite próprio, em segundos
AGENT_TIMEOUT_LONGO_S=1200

# Pesquisa web opcional (o agente já tem a busca nativa do Claude Code)
SERPER_API_KEY=

# Embeddings + rerank: Voyage AI (recomendada pela Anthropic). Chave do MongoDB Atlas > AI Model APIs.
# Grátis até 200M tokens por conta.
VOYAGE_API_KEY=
EMBED_MODEL=voyage-4-large
RERANK_MODEL=rerank-3
EMBED_DIMS=1024
# Limites da sua conta Voyage (sem cartão: 10000 tokens/min e 3 req/min; com cartão: bem maiores)
VOYAGE_TPM=10000
VOYAGE_RPM=3

# Classificações rápidas (Jev / TypeSafe) — opcional; pago por uso (frações de centavo)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Pasta de dados baixados/gerados (gitignored)
DATA_DIR=../data
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
ALLOWED_HOSTS=["127.0.0.1","localhost"]
# Backup diário dos seus dados (conversas, memória, diário, planos) em data/backups, guardado por 30 dias
BACKUP_ENABLED=true
BACKUP_DIR=../data/backups
BACKUP_KEEP_DAYS=30
# PDF: endereço da interface que o Chrome imprime e, se precisar, o caminho do Chrome/Chromium
FRONTEND_URL=http://127.0.0.1:3000
CHROME_BIN=

# ElevenLabs (narração dos vídeos)
ELEVENLABS_API_KEY=
